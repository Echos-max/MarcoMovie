@Override
public String searchContent(String key, boolean quick, String pg) {
    searchError.remove();

    String page = (pg == null || pg.trim().isEmpty()) ? "1" : pg.trim();
    String extra = "&wd=" + encode(key) + "&pg=" + page;

    JsonObject data = null;
    int successfulResponses = 0;
    String lastError = "";

    // 不同 CMS 对搜索动作支持不一：detail / videolist / list 依次尝试
    for (String ac : new String[]{"detail", "videolist", "list"}) {
        JsonObject one = getSearch(buildUrl(ac, extra));

        if (one != null) {
            successfulResponses++;

            if (listSize(one) > 0) {
                data = one;
                break;
            }

            if (data == null) {
                data = one;
            }
        } else {
            String error = getSearchError();
            if (!error.isEmpty()) {
                lastError = error;
            }
        }
    }

    // 只要至少有一次请求成功返回合法 JSON，就按正常搜索结果处理。
    // 如果三种动作全部失败，则保留真实请求错误。
    if (successfulResponses > 0) {
        searchError.remove();
    } else if (!lastError.isEmpty()) {
        searchError.set(lastError);
    }

    JsonObject out = new JsonObject();
    out.add("list", videoArray(data, true));
    return out.toString();
}
