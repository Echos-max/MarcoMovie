private JsonArray parentClassArray() {
    JsonArray parents = new JsonArray();

    String[][] categories = {
        {"1", "电影"},
        {"2", "电视剧"},
        {"3", "综艺"},
        {"4", "动漫"}
    };

    for (String[] category : categories) {
        JsonObject item = new JsonObject();
        item.addProperty("type_id", category[0]);
        item.addProperty("type_name", category[1]);
        parents.add(item);
    }

    return parents;
