import {Pressable, StyleSheet, Text, View} from "react-native";
import {Item, UploadIcon,ChevronRightIcon} from 'panelui-native';
import { useRouter } from "expo-router";

export default function SettingsScreen(){
  const router = useRouter();
  return(
      <View style={styles.container}>
       <View style={styles.Headers}>
         <Text style={styles.Titles}>设置</Text>
       </View>
      {/*  添加订阅*/}
        <View style={{width:"100%",marginTop:'5%',padding:10}}>
          <Item variant="outline">
            <Item.Media variant="icon">
              <UploadIcon size={20} />
            </Item.Media>
            <Item.Content>
              <Item.Title>订阅地址</Item.Title>
              <Item.Description>管理已导入的肥猫影视源和其他配置。</Item.Description>
            </Item.Content>
            <Item.Actions>
              <Pressable
                  onPress={() => {
                    // 3. 确保传入有效的路径，不要传空对象 {}
                    router.push({
                      pathname: '/order/[id]',
                      params: { id: 'manage' },
                    });
                  }}
              >
                <ChevronRightIcon size={30} />
              </Pressable>
            </Item.Actions>
          </Item>
        </View>
      </View>
  )
}
const styles = StyleSheet.create({
  container: {
    flex: 1,
    width: '100%',
  },
  Headers:{
    width: '100%',
    height: '10%',
    flexDirection: 'row',
    justifyContent:'center',
    alignItems:'center',

  },
  Titles:{
    position: 'absolute',
    bottom:0,
    color: 'black',
    fontSize: 30,
    fontWeight: 'bold',
  }
})