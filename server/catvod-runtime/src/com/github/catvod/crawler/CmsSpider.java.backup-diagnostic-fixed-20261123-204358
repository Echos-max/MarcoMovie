/**
 * 搜索专用 HTTP 请求。
 * 不改变普通 get() 方法，避免影响首页、分类、详情和探活。
 */
private JsonObject getSearch(String url) {
    try {
        Request.Builder builder = new Request.Builder().url(url);

        for (Map.Entry<String, String> entry : header.entrySet()) {
            builder.header(entry.getKey(), entry.getValue());
        }

        try (Response response = OkHttp.client(15000L)
                .newCall(builder.build()).execute()) {

            String body = response.body() == null
                    ? ""
                    : response.body().string().trim();

            String cfMitigated = response.header("cf-mitigated");
            boolean cloudflareChallenge =
                    (cfMitigated != null && cfMitigated.equalsIgnoreCase("challenge"))
                    || body.contains("cf-chl-")
                    || body.contains("Just a moment");

            if (!response.isSuccessful()) {
                if (cloudflareChallenge) {
                    searchError.set(
                            "Cloudflare Challenge 拦截（HTTP "
                                    + response.code() + "）"
                    );
                } else {
                    searchError.set(
                            "HTTP 请求失败（HTTP " + response.code() + "）"
                    );
                }
                return null;
            }

            if (body.isEmpty()) {
                searchError.set("搜索接口返回空响应");
                return null;
            }

            if (!body.startsWith("{")) {
                if (cloudflareChallenge || body.toLowerCase().contains("cloudflare")) {
                    searchError.set("检测到 Cloudflare 验证页面，搜索请求未获得 JSON 数据");
                } else {
                    searchError.set("搜索接口返回的不是 JSON 数据");
                }
                return null;
            }

            JsonElement element = JsonParser.parseString(body);

            if (!element.isJsonObject()) {
                searchError.set("搜索接口返回的 JSON 不是对象");
                return null;
            }

            return element.getAsJsonObject();
        }
    } catch (Throwable e) {
        Throwable cause = e;

        while (cause.getCause() != null && cause.getCause() != cause) {
            cause = cause.getCause();
        }

        String message = cause.getMessage();
        if (message == null || message.trim().isEmpty()) {
            message = cause.getClass().getSimpleName();
        }

        searchError.set(
                "搜索网络请求失败（"
                        + cause.getClass().getSimpleName()
                        + "）："
                        + message
        );

        return null;
    }
}
    /** 拼接动作参数并发起请求；detail 动作失败时自动回退 videolist（部分老源只认后者） */
    private JsonObject request(String ac, String extra) {
        String url = buildUrl(ac, extra);
        JsonObject data = get(url);
        if (data == null && "detail".equals(ac)) {
            data = get(buildUrl("videolist", extra));
        }
        return data;
    }

    private String buildUrl(String ac, String extra) {
        StringBuilder builder = new StringBuilder(api);
        builder.append(api.contains("?") ? "&" : "?");
        builder.append("ac=").append(ac == null || ac.isEmpty() ? "list" : ac);
        if (extra != null) builder.append(extra);
        return builder.toString();
    }


    private JsonObject get(String url) {
        long startedAt = System.nanoTime();

        String action = "unknown";
        if (url != null) {
            int index = url.indexOf("ac=");
            if (index >= 0) {
                int end = url.indexOf('&', index);
                action = url.substring(index + 3,
                        end >= 0 ? end : url.length());
            }
        }

        try {
            Request.Builder builder = new Request.Builder().url(url);

            for (Map.Entry<String, String> entry : header.entrySet()) {
                builder.header(entry.getKey(), entry.getValue());
            }

            try (Response response = OkHttp.client(15000L)
                    .newBuilder()
                    .protocols(java.util.Collections.singletonList(
                            okhttp3.Protocol.HTTP_1_1))
                    .callTimeout(15L, java.util.concurrent.TimeUnit.SECONDS)
                    .build()
                    .newCall(builder.build())
                    .execute()) {

                int status = response.code();
                JsonObject result = null;

                if (response.body() != null) {
                    String text = response.body().string().trim();

                    if (!text.isEmpty() && text.startsWith("{")) {
                        JsonElement element = JsonParser.parseString(text);

                        if (element.isJsonObject()) {
                            result = element.getAsJsonObject();
                        }
                    }
                }

                long cost = (System.nanoTime() - startedAt) / 1_000_000L;

                System.out.println(
                        "[CMS请求] site=" + siteKey
                                + " action=" + action
                                + " http=" + status
                                + " cost=" + cost + "ms"
                                + " result=" + (result == null ? "empty" : "json")
                );

                return result;
            }
        } catch (Throwable e) {
            long cost = (System.nanoTime() - startedAt) / 1_000_000L;

            System.out.println(
                    "[CMS请求失败] site=" + siteKey
                            + " action=" + action
                            + " cost=" + cost + "ms"
                            + " error=" + e.getClass().getSimpleName()
            );

            return null;
        }
    }


    /** 探活：请求一次 ac=list，返回可用性 / 耗时 / 分类数 / 站点总数，供源池测速使用 */
    public static Map<String, Object> probe(String api, String ext) {
        Map<String, Object> result = new LinkedHashMap<>();
        long start = System.currentTimeMillis();
        CmsSpider spider = new CmsSpider("probe", "probe", api, ext, "");
        JsonObject data = spider.get(spider.buildUrl(spider.homeAc, null));
        result.put("latency", System.currentTimeMillis() - start);
        if (data == null) {
            result.put("ok", false);
            result.put("message", "接口无响应或返回非 JSON");
            result.put("classCount", 0);
            result.put("total", 0);
            return result;
        }
        int classCount = data.has("class") && data.get("class").isJsonArray() ? data.getAsJsonArray("class").size() : 0;
        int total = intOf(data, "total");
        result.put("ok", true);
        result.put("classCount", classCount);
        result.put("total", total);
        result.put("message", "可用：分类 " + classCount + " 个，资源 " + total + " 条");
        return result;
    }

