import { randomUUID } from 'node:crypto';
import { mkdir, readFile, rename, unlink, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const CURRENT_DIR = path.dirname(fileURLToPath(import.meta.url));
const DATA_DIR = path.resolve(CURRENT_DIR, '../data');
const STORE_PATH = path.join(DATA_DIR, 'subscriptions.json');
const SNAPSHOT_DIR = path.join(DATA_DIR, 'subscription-snapshots');

let store = null;
let writeQueue = Promise.resolve();

function createEmptyStore() {
  return {
    version: 1,
    subscriptions: [],
  };
}

function validateStore(data) {
  if (
    !data ||
    typeof data !== 'object' ||
    data.version !== 1 ||
    !Array.isArray(data.subscriptions)
  ) {
    throw new Error('订阅清单格式错误，拒绝覆盖现有文件');
  }

  for (const item of data.subscriptions) {
    if (
      !item ||
      typeof item !== 'object' ||
      typeof item.id !== 'string' ||
      typeof item.name !== 'string' ||
      typeof item.url !== 'string'
    ) {
      throw new Error('订阅清单包含无效记录，拒绝覆盖现有文件');
    }
  }

  return data;
}

async function writeStore(nextStore = store) {
  const temporaryPath = `${STORE_PATH}.${process.pid}.${randomUUID()}.tmp`;
  const content = `${JSON.stringify(nextStore, null, 2)}\n`;

  try {
    await writeFile(temporaryPath, content, 'utf8');
    await rename(temporaryPath, STORE_PATH);
  } catch (error) {
    const { unlink } = await import('node:fs/promises');
    await unlink(temporaryPath).catch(() => {});
    throw error;
  }
}

function enqueueWrite(operation) {
  const task = writeQueue.then(operation);
  writeQueue = task.catch(() => {});
  return task;
}

export async function initSubscriptionStore() {
  await mkdir(DATA_DIR, { recursive: true });
  await mkdir(SNAPSHOT_DIR, { recursive: true });

  try {
    const content = await readFile(STORE_PATH, 'utf8');
    store = validateStore(JSON.parse(content));
  } catch (error) {
    if (error.code !== 'ENOENT') {
      if (error instanceof SyntaxError) {
        throw new Error(`订阅清单 JSON 解析失败：${error.message}`);
      }
      throw error;
    }

    store = createEmptyStore();
    await writeStore();
  }

  return {
    count: store.subscriptions.length,
    snapshotDirectory: SNAPSHOT_DIR,
  };
}

function ensureInitialized() {
  if (!store) {
    throw new Error('订阅存储尚未初始化，请先调用 initSubscriptionStore()');
  }
}

export function listSubscriptions() {
  ensureInitialized();

  return store.subscriptions.map(item => ({ ...item }));
}

export function getSubscription(id) {
  ensureInitialized();

  const item = store.subscriptions.find(entry => entry.id === id);
  return item ? { ...item } : null;
}

export async function createSubscription(input) {
  ensureInitialized();

  const name = String(input?.name || '').trim();
  const url = String(input?.url || '').trim();

  if (!name) {
    throw new Error('订阅名称不能为空');
  }

  let parsedUrl;
  try {
    parsedUrl = new URL(url);
  } catch {
    throw new Error('订阅地址格式不正确');
  }

  if (!['http:', 'https:'].includes(parsedUrl.protocol)) {
    throw new Error('订阅地址只允许使用 HTTP 或 HTTPS');
  }

  return enqueueWrite(async () => {
    const now = Date.now();

    const subscription = {
      id: randomUUID(),
      name,
      url,
      enabled: true,
      status: 'pending',
      sourceCount: 0,
      lastRefreshedAt: null,
      lastError: '',
      createdAt: now,
      updatedAt: now,
    };

    const previousSubscriptions = store.subscriptions;
    store.subscriptions = [...previousSubscriptions, subscription];

    try {
      await writeStore();
    } catch (error) {
      store.subscriptions = previousSubscriptions;
      throw error;
    }

    return { ...subscription };
  });
}

export function getSubscriptionSnapshotPath(id) {
  if (!/^[0-9a-f-]{36}$/i.test(String(id || ''))) {
    throw new Error('无效的订阅 ID');
  }

  return path.join(SNAPSHOT_DIR, `${id}.json`);
}
const ALLOWED_SUBSCRIPTION_UPDATES = new Set([
  'status',
  'sourceCount',
  'lastRefreshedAt',
  'lastError',
]);

export async function updateSubscription(id, changes) {
  ensureInitialized();

  if (!id || !changes || typeof changes !== 'object' || Array.isArray(changes)) {
    throw new Error('订阅更新参数不正确');
  }

  const entries = Object.entries(changes);

  if (entries.length === 0 || entries.some(([key]) => !ALLOWED_SUBSCRIPTION_UPDATES.has(key))) {
    throw new Error('包含不允许更新的订阅字段');
  }

  return enqueueWrite(async () => {
    const index = store.subscriptions.findIndex(item => item.id === id);

    if (index < 0) {
      throw new Error('订阅不存在');
    }

    const previousSubscriptions = store.subscriptions;
    const updatedSubscription = {
      ...previousSubscriptions[index],
      ...changes,
      updatedAt: Date.now(),
    };

    if (
      typeof updatedSubscription.status !== 'string' ||
      !Number.isInteger(updatedSubscription.sourceCount) ||
      updatedSubscription.sourceCount < 0 ||
      typeof updatedSubscription.lastError !== 'string'
    ) {
      throw new Error('订阅状态字段格式不正确');
    }

    store.subscriptions = previousSubscriptions.map((item, itemIndex) =>
      itemIndex === index ? updatedSubscription : item,
    );

    try {
      await writeStore();
    } catch (error) {
      store.subscriptions = previousSubscriptions;
      throw error;
    }

    return { ...updatedSubscription };
  });
}

export async function saveSubscriptionSnapshot(id, config) {
  ensureInitialized();


  const snapshotPath = getSubscriptionSnapshotPath(id);

  if (!store.subscriptions.some(item => item.id === id)) {
    throw new Error('订阅不存在，不能保存快照');
  }

  if (!config || typeof config !== 'object' || Array.isArray(config)) {
    throw new Error('订阅快照内容不正确');
  }

  return enqueueWrite(async () => {
    const temporaryPath = `${snapshotPath}.${process.pid}.${randomUUID()}.tmp`;
    const content = `${JSON.stringify(config, null, 2)}\n`;

    try {
      await writeFile(temporaryPath, content, 'utf8');
      await rename(temporaryPath, snapshotPath);
    } catch (error) {
      const { unlink } = await import('node:fs/promises');
      await unlink(temporaryPath).catch(() => {});
      throw error;
    }

    return snapshotPath;
  });
}

export async function commitSubscriptionRefresh(id, config, changes) {
  ensureInitialized();

  const snapshotPath = getSubscriptionSnapshotPath(id);

  if (!config || typeof config !== 'object' || Array.isArray(config)) {
    throw new Error('订阅快照内容不正确');
  }

  if (!changes || typeof changes !== 'object' || Array.isArray(changes)) {
    throw new Error('订阅刷新状态参数不正确');
  }

  const entries = Object.entries(changes);

  if (
    entries.length === 0 ||
    entries.some(([key]) => !ALLOWED_SUBSCRIPTION_UPDATES.has(key))
  ) {
    throw new Error('包含不允许更新的订阅字段');
  }

  const serializedConfig = JSON.stringify(config, null, 2);

  if (!serializedConfig) {
    throw new Error('订阅快照序列化失败');
  }

  return enqueueWrite(async () => {
    const index = store.subscriptions.findIndex(item => item.id === id);

    if (index < 0) {
      throw new Error('订阅不存在');
    }

    const previousStore = store;
    const updatedSubscription = {
      ...previousStore.subscriptions[index],
      ...changes,
      updatedAt: Date.now(),
    };

    if (
      typeof updatedSubscription.status !== 'string' ||
      !Number.isInteger(updatedSubscription.sourceCount) ||
      updatedSubscription.sourceCount < 0 ||
      !(
        updatedSubscription.lastRefreshedAt === null ||
        typeof updatedSubscription.lastRefreshedAt === 'number'
      ) ||
      typeof updatedSubscription.lastError !== 'string'
    ) {
      throw new Error('订阅刷新状态字段格式不正确');
    }

    const nextStore = {
      ...previousStore,
      subscriptions: previousStore.subscriptions.map((item, itemIndex) =>
        itemIndex === index ? updatedSubscription : item,
      ),
    };

    const temporaryPath = `${snapshotPath}.${process.pid}.${randomUUID()}.tmp`;
    const backupPath = `${snapshotPath}.${process.pid}.${randomUUID()}.bak`;

    let hasPreviousSnapshot = false;
    let snapshotInstalled = false;

    try {
      await writeFile(temporaryPath, `${serializedConfig}\n`, 'utf8');

      try {
        await rename(snapshotPath, backupPath);
        hasPreviousSnapshot = true;
      } catch (error) {
        if (error.code !== 'ENOENT') {
          throw error;
        }
      }

      await rename(temporaryPath, snapshotPath);
      snapshotInstalled = true;

      store = nextStore;
      await writeStore(nextStore);
    } catch (error) {
      store = previousStore;

      if (snapshotInstalled) {
        await unlink(snapshotPath).catch(() => {});
      }

      if (hasPreviousSnapshot) {
        try {
          await rename(backupPath, snapshotPath);
        } catch (restoreError) {
          throw new Error(
            `订阅刷新失败，且旧快照恢复失败：${restoreError.message}`,
            { cause: error },
          );
        }
      }

      await unlink(temporaryPath).catch(() => {});
      throw error;
    }

    if (hasPreviousSnapshot) {
      await unlink(backupPath).catch(() => {});
    }

    return {
      subscription: { ...updatedSubscription },
      snapshotPath,
    };
  });
}
